# Application Configuration
APP_NAME=Giuseppe Dashboard API
APP_VERSION=1.0.0
DEBUG=False
ENV=production

# Database Configuration
DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/giuseppe_dashboard
DATABASE_ECHO=False

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_EXPIRY=3600

# Security Configuration
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_EXPIRY_HOURS=24

# API Keys
WEATHER_API_KEY=your-openweathermap-api-key
OPENWEATHERMAP_API_URL=https://api.openweathermap.org/data/2.5

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
CORS_CREDENTIALS=True
CORS_METHODS=["*"]
CORS_HEADERS=["*"]

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Apple Health Configuration
APPLE_HEALTH_IMPORT_ENABLED=True

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=giuseppe-dashboard
AWS_S3_REGION=us-east-1

# Feature Flags
ENABLE_NOTIFICATIONS=True
ENABLE_FEED=True
