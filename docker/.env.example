# Database Configuration
DATABASE_URL=postgresql+asyncpg://dashboard:password@postgres:5432/dashboard
POSTGRES_USER=dashboard
POSTGRES_PASSWORD=password
POSTGRES_DB=dashboard
DB_PORT=5432

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# Backend Configuration
SECRET_KEY=change-me-in-production-with-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=30
ENVIRONMENT=development
LOG_LEVEL=info
BACKEND_PORT=8000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NODE_ENV=development
FRONTEND_PORT=3000

# External APIs
WEATHER_API_KEY=your-openweathermap-api-key
WEATHER_API_UNITS=metric
WEATHER_CACHE_HOURS=1

# Apple Health Sync
APPLE_HEALTH_WEBHOOK_SECRET=your-webhook-secret-key
APPLE_HEALTH_SYNC_ENABLED=false

# Email Configuration (Optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@dashboard.local
EMAIL_ENABLED=false

# Sentry/Error Tracking (Optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Security
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000
