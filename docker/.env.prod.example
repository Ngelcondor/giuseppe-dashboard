# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=dashboard
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=dashboard

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ─── Backend ──────────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
CORS_ORIGINS=https://your-domain.com

# ─── Admin bootstrap credentials ──────────────────────────────────────────────
# Used by seed_admin_user() on first startup AND by POST /auth/init
# (only when ALLOW_ADMIN_INIT=true). Generate a strong password with:
#   openssl rand -base64 24
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_24

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://your-domain.com/api/v1

# ─── Push Notifications (genera con: npx web-push generate-vapid-keys) ───────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ─── Weather API ──────────────────────────────────────────────────────────────
WEATHER_API_KEY=

# ─── Apple Health ─────────────────────────────────────────────────────────────
# Legacy global secret for iOS Shortcuts webhooks. Preferisci un API token
# per-utente (Impostazioni → API tokens): lega il webhook all'account giusto.
APPLE_HEALTH_WEBHOOK_SECRET=

# ─── Open Banking (Enable Banking) ────────────────────────────────────────────
# REQUIRED for bank sync since the App ID no longer has a default in code.
# App ID from https://enablebanking.com/ · private RSA key in APP_SECRET.
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_APP_SECRET=
ENABLE_BANKING_REDIRECT_URL=https://your-domain.com/dashboard/budget
